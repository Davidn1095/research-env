# Atlas analysis container, revision c: atlas-2026.10b (pinned by digest) plus rpy2 and anndata2ri,
# so that the Python pipeline calls DecontX and scDblFinder through rpy2 as the sc-best-practices
# notebooks do (book environment preprocessing_visualization.yml: rpy2 3.6.8, anndata2ri 2.0.1).
# Installed with the image's own pip freeze as constraints, so no existing package moves.
# Built by .github/workflows/build-atlas-c.yml; tag atlas-2026.10c.
FROM ghcr.io/davidn1095/research-env:atlas-2026.10b@sha256:4ec15f64245a5a46ec58a289df5a273b9a652521306398c43f1658a9690d5f31

RUN set -e && pip freeze > /opt/atlas-2026.10b.freeze.txt && \
    pip install --no-cache-dir -c /opt/atlas-2026.10b.freeze.txt \
        "rpy2==3.6.8" "rpy2-rinterface==3.6.7" "rpy2-robjects==3.6.6" "anndata2ri==2.0.1" \
        "cffi==2.1.1" "pycparser==3.12" "tzlocal==5.4.5" && \
    pip freeze > /opt/atlas-2026.10c.freeze.txt && \
    if diff /opt/atlas-2026.10b.freeze.txt /opt/atlas-2026.10c.freeze.txt | grep '^<'; then exit 1; fi

COPY tests/atlas_c_load_test.py /opt/atlas-tests/
